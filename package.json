{
  "name": "one-click-distributor",
  "description": "Markdown multi-platform draft distribution Chrome extension.",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
